<Window x:Class="FileOrganizer.App.DuplicatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find Duplicates" Width="700" Height="480" MinWidth="540" MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="🔄 Scan" FontWeight="Bold" Click="Scan_Click" Margin="6,0,0,0"/>
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click"/>
                    <TextBox x:Name="FolderBox"/>
                </DockPanel>
                <TextBlock x:Name="StatusText" Margin="0,6,0,0"
                           Text="Exact duplicates only (same size + SHA-256). Nothing is deleted without your confirmation." TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- §8 Duplicate groups -->
        <ListBox Grid.Row="1" x:Name="GroupsList" Margin="0,8,0,0" FontFamily="Consolas"/>

        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock Text="Keep:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="KeepCombo" Width="110" SelectedIndex="0">
                <ComboBoxItem Tag="KeepFirst">First</ComboBoxItem>
                <ComboBoxItem Tag="KeepNewest">Newest</ComboBoxItem>
                <ComboBoxItem Tag="KeepOldest">Oldest</ComboBoxItem>
            </ComboBox>
            <Button Content="Move Duplicates to Trash Folder…" Click="MoveDuplicates_Click" Margin="10,0,0,0"/>
            <Button Content="Delete Duplicates…" Click="DeleteDuplicates_Click"/>
            <Button Content="Close" IsCancel="True" Margin="10,0,0,0"/>
        </WrapPanel>
    </Grid>
</Window>
