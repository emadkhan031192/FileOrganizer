<Window x:Class="FileOrganizer.App.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Organizer — Glass Gallery (Phase 1)" Width="900" Height="700"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        FontFamily="{StaticResource GlassFontFamily}" FontSize="13"
        Foreground="{DynamicResource GlassTextPrimary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Glass Gallery" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource GlassTextPrimary}"/>
            <TextBlock Text="Every Phase 1 component, live. Change the theme, accent or intensity below and the whole gallery updates — that is the design system working."
                       TextWrapping="Wrap" Foreground="{DynamicResource GlassTextSecondary}" Margin="0,4,0,16"/>

            <!-- Controls that drive the design system. -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource GlassTextPrimary}"/>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="Theme:" VerticalAlignment="Center" Foreground="{DynamicResource GlassTextSecondary}" Margin="0,0,6,0"/>
                        <Button Content="Auto" Style="{StaticResource GlassButton}" Click="ThemeAuto_Click"/>
                        <Button Content="Light" Style="{StaticResource GlassButton}" Click="ThemeLight_Click"/>
                        <Button Content="Dark" Style="{StaticResource GlassButton}" Click="ThemeDark_Click"/>
                        <CheckBox x:Name="AdaptiveTintCheck" Content="Adaptive tint (wallpaper colour)" VerticalAlignment="Center" Margin="12,0,0,0" Click="Appearance_Click"/>
                        <CheckBox x:Name="ReduceMotionCheck" Content="Reduce motion" VerticalAlignment="Center" Margin="12,0,0,0" Click="Appearance_Click"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="Accent:" VerticalAlignment="Center" Foreground="{DynamicResource GlassTextSecondary}" Margin="0,0,6,0"/>
                        <Button Content="Blue" Style="{StaticResource GlassButton}" Tag="#2563EB" Click="Accent_Click"/>
                        <Button Content="Teal" Style="{StaticResource GlassButton}" Tag="#0F766E" Click="Accent_Click"/>
                        <Button Content="Purple" Style="{StaticResource GlassButton}" Tag="#7C3AED" Click="Accent_Click"/>
                        <Button Content="Orange" Style="{StaticResource GlassButton}" Tag="#EA580C" Click="Accent_Click"/>
                        <TextBlock Text="Glass intensity:" VerticalAlignment="Center" Foreground="{DynamicResource GlassTextSecondary}" Margin="12,0,6,0"/>
                        <Slider x:Name="IntensitySlider" Width="140" Minimum="0.5" Maximum="1.5" Value="1.0" VerticalAlignment="Center" ValueChanged="Intensity_Changed"/>
                        <TextBlock x:Name="IntensityText" Text="1.0" VerticalAlignment="Center" Foreground="{DynamicResource GlassTextSecondary}" Margin="6,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Buttons, petals, pill, chips. -->
            <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Buttons, petals, pill, chips" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource GlassTextPrimary}"/>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Glass button" Style="{StaticResource GlassButton}"/>
                        <Button Content="Primary" Style="{StaticResource GlassPrimaryButton}"/>
                        <Button x:Name="SpringButton" Content="Spring me" Style="{StaticResource GlassPrimaryButton}" Click="SpringButton_Click"/>
                        <Border x:Name="SpringCard" Style="{StaticResource GlassCard}" Width="150" Height="60" Margin="12,0,0,0">
                            <TextBlock Text="I spring on tap" VerticalAlignment="Center" Foreground="{DynamicResource GlassTextPrimary}"/>
                        </Border>
                    </WrapPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource GlassPetalButton}" ToolTip="Folder" AutomationProperties.Name="Folder petal">
                            <Path Data="{StaticResource IconFolder}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="24" Height="24" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource GlassPetalButton}" ToolTip="Organize" AutomationProperties.Name="Organize petal">
                            <Path Data="{StaticResource IconOrganize}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="24" Height="24" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource GlassPetalButton}" ToolTip="Recycle Bin" AutomationProperties.Name="Recycle Bin petal">
                            <Path Data="{StaticResource IconRecycle}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="24" Height="24" Stretch="Uniform"/>
                        </Button>
                        <Border Style="{StaticResource GlassPill}" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCheck}" Stroke="{DynamicResource GlassGreen}" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform"/>
                                <TextBlock Text="12 items → Jobs" Margin="8,0,8,0" Foreground="{DynamicResource GlassTextPrimary}"/>
                                <Button Content="Undo" Style="{StaticResource GlassButton}" Padding="8,2" Margin="0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <WrapPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource GlassChip}"><TextBlock Text="PDF · 3 files" FontSize="11" Foreground="{DynamicResource GlassTextPrimary}"/></Border>
                        <Border Style="{StaticResource GlassChip}" Background="{DynamicResource GlassAmberSoft}"><TextBlock Text="Conflict: rename" FontSize="11" Foreground="{DynamicResource GlassAmber}"/></Border>
                        <Border Style="{StaticResource GlassChip}" Background="{DynamicResource GlassGreenSoft}"><TextBlock Text="Suggested" FontSize="11" Foreground="{DynamicResource GlassGreen}"/></Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Tiles and segmented control. -->
            <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Tiles and segmented control" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource GlassTextPrimary}"/>
                    <UniformGrid Columns="3" Margin="0,8,0,0">
                        <Button Style="{StaticResource GlassTileButton}" Margin="4">
                            <StackPanel>
                                <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource GlassTextPrimary}" Width="24" Height="24" Stretch="Uniform"/>
                                <TextBlock Text="Jobs" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextPrimary}" Margin="0,6,0,0"/>
                                <TextBlock Text="Last used today · 42 items" FontSize="11" Foreground="{DynamicResource GlassTextSecondary}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GlassTileButton}" Margin="4">
                            <StackPanel>
                                <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource GlassTextPrimary}" Width="24" Height="24" Stretch="Uniform"/>
                                <TextBlock Text="Advertisements" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextPrimary}" Margin="0,6,0,0"/>
                                <TextBlock Text="Last used yesterday" FontSize="11" Foreground="{DynamicResource GlassTextSecondary}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GlassTileButton}" Margin="4">
                            <StackPanel>
                                <Path Data="{StaticResource IconSparkle}" Fill="{DynamicResource GlassTextPrimary}" Width="24" Height="24" Stretch="Uniform"/>
                                <TextBlock Text="Suggested" FontWeight="SemiBold" Foreground="{DynamicResource GlassTextPrimary}" Margin="0,6,0,0"/>
                                <TextBlock Text="Based on file type" FontSize="11" Foreground="{DynamicResource GlassTextSecondary}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <Border Style="{StaticResource GlassSegmentedContainer}" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Content="By type" Style="{StaticResource GlassSegmentButton}" IsChecked="True"/>
                            <ToggleButton Content="By date" Style="{StaticResource GlassSegmentButton}"/>
                            <ToggleButton Content="My rules" Style="{StaticResource GlassSegmentButton}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Icon set. -->
            <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Icon set (vector, no emoji)" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource GlassTextPrimary}"/>
                    <TextBlock Text="Every icon below is one embedded PathGeometry from GlassIcons.xaml, drawn in the current text colour."
                               TextWrapping="Wrap" Foreground="{DynamicResource GlassTextSecondary}" Margin="0,4,0,8"/>
                    <WrapPanel x:Name="IconPanel"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Phase 1 only: this gallery previews the design system. The hub, wheels, pill and layouts arrive in Phases 2–5."
                       TextWrapping="Wrap" Foreground="{DynamicResource GlassTextTertiary}" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
