<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         File Organizer — Glass component styles (Phase 1)
         Every surface: translucent tint + specular edge + two shadows
         (wide soft, tight) + noise overlay where a template allows it.
         Only transform and opacity are animated (see SpringAnimator);
         these templates never animate size or hit-test area.
         ============================================================ -->

    <Style x:Key="GlassFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource GlassAccent}" BorderThickness="2"
                            CornerRadius="{StaticResource GlassRadiusButton}" Margin="-3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass card: a Border. The wide soft shadow is the outer effect;
         the tight shadow is approximated by the specular edge stroke. -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource GlassRadiusCard}"/>
        <Setter Property="Padding" Value="{StaticResource GlassPaddingCard}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.22" Color="#5B6B8C"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Glass button. -->
    <Style x:Key="GlassButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource GlassFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource GlassTextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource GlassSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassEdge}"/>
        <Setter Property="Padding" Value="{StaticResource GlassPaddingButton}"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource GlassRadiusButton}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" Color="#5B6B8C"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassAccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassTint}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary glass button: accent fill, ink at 90% white text. -->
    <Style x:Key="GlassPrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Background" Value="{DynamicResource GlassAccent}"/>
        <Setter Property="Foreground">
            <Setter.Value>
                <SolidColorBrush Color="#FFFFFF" Opacity="0.90"/>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource GlassRadiusButton}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.28" Color="#2563EB"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassAccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fully round petal (wheel destinations). 64px, icon only. -->
    <Style x:Key="GlassPetalButton" TargetType="Button">
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="64"/>
        <Setter Property="FontFamily" Value="{StaticResource GlassFontFamily}"/>
        <Setter Property="Foreground" Value="{DynamicResource GlassTextPrimary}"/>
        <Setter Property="Background" Value="{DynamicResource GlassSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassEdge}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource GlassRadiusPetal}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.25" Color="#5B6B8C"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassAccent}"/>
                            <Setter Property="Foreground">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FFFFFF" Opacity="0.90"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassAccentHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Live pill (Dynamic-Island style): fully round, compact. -->
    <Style x:Key="GlassPill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource GlassRadiusPill}"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.25" Color="#5B6B8C"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small chip (reason, conflict, count). -->
    <Style x:Key="GlassChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassAccentSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="{StaticResource GlassPaddingChip}"/>
    </Style>

    <!-- Large destination tile (Move/Home grid). -->
    <Style x:Key="GlassTileButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource GlassRadiusCard}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.20" Color="#5B6B8C"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassAccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassTint}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented control: container + toggle buttons. -->
    <Style x:Key="GlassSegmentedContainer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassSurface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource GlassRadiusButton}"/>
        <Setter Property="Padding" Value="4"/>
    </Style>
    <Style x:Key="GlassSegmentButton" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource GlassFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource GlassTextSecondary}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassAccent}"/>
                            <Setter Property="Foreground">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FFFFFF" Opacity="0.90"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassAccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
