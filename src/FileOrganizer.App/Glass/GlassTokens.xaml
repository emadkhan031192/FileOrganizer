<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         File Organizer — Glass Design Tokens (Phase 1)
         Light / Dark / Auto are resolved by GlassTheme (Glass/ThemeHelper.cs),
         which swaps the "current" brushes below. Text is never pure black
         or white: it is ink at 90% / 60% / 35% opacity.
         Concentric radii: window 20, card 16, button 12, petal fully round.
         ============================================================ -->

    <FontFamily x:Key="GlassFontFamily">Segoe UI Variable, Segoe UI</FontFamily>

    <CornerRadius x:Key="GlassRadiusWindow">20</CornerRadius>
    <CornerRadius x:Key="GlassRadiusCard">16</CornerRadius>
    <CornerRadius x:Key="GlassRadiusButton">12</CornerRadius>
    <CornerRadius x:Key="GlassRadiusPetal">32</CornerRadius>
    <CornerRadius x:Key="GlassRadiusPill">999</CornerRadius>

    <Thickness x:Key="GlassPaddingCard">16</Thickness>
    <Thickness x:Key="GlassPaddingButton">12,8</Thickness>
    <Thickness x:Key="GlassPaddingChip">8,4</Thickness>

    <!-- Tint: white 12% (light) / black 28% (dark). GlassTheme scales the
         opacity by the user's Glass Intensity setting for readability. -->
    <SolidColorBrush x:Key="GlassTintLight" Color="#FFFFFF" Opacity="0.12"/>
    <SolidColorBrush x:Key="GlassTintDark" Color="#000000" Opacity="0.28"/>
    <SolidColorBrush x:Key="GlassTint" Color="#FFFFFF" Opacity="0.12"/>

    <!-- Fake-glass surface (small transparent layered windows, where real
         DWM blur does not work): a translucent surface over whatever is behind. -->
    <SolidColorBrush x:Key="GlassSurfaceLight" Color="#FFFFFF" Opacity="0.72"/>
    <SolidColorBrush x:Key="GlassSurfaceDark" Color="#1E2430" Opacity="0.72"/>
    <SolidColorBrush x:Key="GlassSurface" Color="#FFFFFF" Opacity="0.72"/>

    <!-- Specular edge: bright top-left, fading around. Used as a BorderBrush. -->
    <LinearGradientBrush x:Key="GlassEdgeLight" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#80FFFFFF" Offset="0.45"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdgeDark" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#33FFFFFF" Offset="0.45"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#80FFFFFF" Offset="0.45"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Text hierarchy: ink at 90% / 60% / 35%. Light theme uses black ink,
         dark theme uses white ink; GlassTheme swaps these. -->
    <SolidColorBrush x:Key="GlassTextPrimaryLight" Color="#000000" Opacity="0.90"/>
    <SolidColorBrush x:Key="GlassTextSecondaryLight" Color="#000000" Opacity="0.60"/>
    <SolidColorBrush x:Key="GlassTextTertiaryLight" Color="#000000" Opacity="0.35"/>
    <SolidColorBrush x:Key="GlassTextPrimaryDark" Color="#FFFFFF" Opacity="0.90"/>
    <SolidColorBrush x:Key="GlassTextSecondaryDark" Color="#FFFFFF" Opacity="0.60"/>
    <SolidColorBrush x:Key="GlassTextTertiaryDark" Color="#FFFFFF" Opacity="0.35"/>
    <SolidColorBrush x:Key="GlassTextPrimary" Color="#000000" Opacity="0.90"/>
    <SolidColorBrush x:Key="GlassTextSecondary" Color="#000000" Opacity="0.60"/>
    <SolidColorBrush x:Key="GlassTextTertiary" Color="#000000" Opacity="0.35"/>

    <!-- Accent (user-pickable; GlassTheme sets these from AccentHex). -->
    <SolidColorBrush x:Key="GlassAccent" Color="#2563EB"/>
    <SolidColorBrush x:Key="GlassAccentHover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="GlassAccentSoft" Color="#2563EB" Opacity="0.15"/>

    <!-- Semantic brushes. -->
    <SolidColorBrush x:Key="GlassAmber" Color="#D97706"/>
    <SolidColorBrush x:Key="GlassAmberSoft" Color="#D97706" Opacity="0.15"/>
    <SolidColorBrush x:Key="GlassRed" Color="#DC2626"/>
    <SolidColorBrush x:Key="GlassRedSoft" Color="#DC2626" Opacity="0.15"/>
    <SolidColorBrush x:Key="GlassGreen" Color="#059669"/>
    <SolidColorBrush x:Key="GlassGreenSoft" Color="#059669" Opacity="0.15"/>

    <!-- Faint noise texture (about 3%): a tiled drawing of tiny dots, used as
         an overlay on glass surfaces to break up flat gradients. -->
    <DrawingBrush x:Key="GlassNoise" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup Opacity="0.03">
                <GeometryDrawing Brush="#000000">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="1,1,1,1"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="5,5,1,1"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
