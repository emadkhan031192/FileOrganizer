<Window x:Class="FileOrganizer.App.WheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Organizer Wheel" Width="420" Height="420"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" AllowDrop="True"
        FontFamily="{StaticResource GlassFontFamily}" FontSize="13">
    <Window.Resources>
        <!-- Recycle petal: neutral glass normally, red only on hover (spec). -->
        <Style x:Key="RecyclePetalButton" TargetType="Button" BasedOn="{StaticResource GlassPetalButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource GlassRadiusPetal}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.25" Color="#5B6B8C"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassRed}"/>
                                <Setter Property="Foreground">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FFFFFF" Opacity="0.90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Canvas x:Name="RootCanvas">
        <!-- Centre glass lens: file stack, count, total size, hovered petal name, wheel keycap. -->
        <Border x:Name="CentreLens" Width="140" Height="140" Canvas.Left="140" Canvas.Top="140"
                Style="{StaticResource GlassCard}" CornerRadius="70" Padding="8" AllowDrop="True">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path x:Name="CentreIcon" Data="{StaticResource IconFile}" Fill="{DynamicResource GlassTextPrimary}"
                      Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock x:Name="CountText" Text="Nothing selected" FontWeight="SemiBold" TextAlignment="Center"
                           Foreground="{DynamicResource GlassTextPrimary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="SizeText" Text="" FontSize="11" TextAlignment="Center"
                           Foreground="{DynamicResource GlassTextSecondary}"/>
                <TextBlock x:Name="HoverText" Text="Pick a destination" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource GlassTextSecondary}" Margin="0,2,0,0"/>
                <Border CornerRadius="6" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1"
                        Padding="6,2" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock x:Name="KeycapText" Text="Shift" FontSize="10" Foreground="{DynamicResource GlassTextSecondary}"/>
                </Border>
            </StackPanel>
        </Border>
        <!-- Moving glass ring: glides between petals, never jumps. -->
        <Border x:Name="HighlightRing" Width="76" Height="76" Canvas.Left="172" Canvas.Top="172"
                CornerRadius="38" BorderBrush="{DynamicResource GlassAccent}" BorderThickness="2" Opacity="0.9"/>
        <!-- Check drawn in the centre on drop success. -->
        <Border x:Name="CheckMark" Width="48" Height="48" Canvas.Left="186" Canvas.Top="186" Opacity="0">
            <Path Data="{StaticResource IconCheck}" Stroke="{DynamicResource GlassGreen}" StrokeThickness="3"
                  Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <!-- Close button: the wheel is non-activating, so it never closes on
             deactivation and previously had no mouse way to dismiss it at all
             (Esc via the keyboard hook was the only exit). -->
        <Button x:Name="CloseBtn" Width="28" Height="28" Canvas.Left="382" Canvas.Top="10"
                Style="{StaticResource GlassPetalButton}" ToolTip="Close wheel (Esc)">
            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource GlassTextPrimary}"
                  Width="14" Height="14" Stretch="Uniform"/>
        </Button>
    </Canvas>
</Window>
