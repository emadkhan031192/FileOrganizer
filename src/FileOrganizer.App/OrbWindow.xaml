<Window x:Class="FileOrganizer.App.OrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Organizer Orb" Width="80" Height="80"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" AllowDrop="True"
        FontFamily="{StaticResource GlassFontFamily}">
    <Grid x:Name="RootGrid" Width="80" Height="80">
        <!-- Idle glow: fades only (never scales), so the hover area never changes size. -->
        <Border x:Name="GlowBorder" Width="72" Height="72" CornerRadius="36"
                Background="{DynamicResource GlassAccentSoft}" Opacity="0.35" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <!-- One true glass circle. Its clip keeps the light sweep inside the circle. -->
        <Grid Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.Clip>
                <EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32"/>
            </Grid.Clip>
            <Border x:Name="OrbBorder" Style="{StaticResource GlassCard}" CornerRadius="32" Padding="0"
                    MouseLeftButtonDown="Orb_DragOrClick" MouseEnter="Orb_MouseEnter" MouseLeave="Orb_MouseLeave"
                    Drop="Orb_Drop" DragOver="Orb_DragOver">
                <Path Data="{StaticResource IconWheel}" Fill="{DynamicResource GlassTextPrimary}"
                      Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <!-- Light sweep across the surface every ~6 s. -->
            <Border x:Name="SweepBorder" Width="20" Height="64" Opacity="0" IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#80FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <TranslateTransform X="-64"/>
                </Border.RenderTransform>
            </Border>
        </Grid>
    </Grid>
</Window>
