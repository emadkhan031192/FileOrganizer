<Window x:Class="FileOrganizer.App.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to File Organizer" Width="480" Height="360" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Welcome to File Organizer" FontSize="20" FontWeight="Bold"/>
        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="One job: select files in Explorer, click a destination, and they move. That's it. The rest is optional."/>
        <TextBlock Text="Your starting destinations (change them anytime in Settings):" FontWeight="SemiBold" Margin="0,16,0,0"/>
        <TextBlock x:Name="DestinationsText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}"/>
        <CheckBox x:Name="WatchCheck" Content="Auto-sort new files in Downloads" Margin="0,16,0,0"/>
        <CheckBox x:Name="WheelOnlyCheck" Content="Wheel-only bar — just a small ◉ circle (drop files on it for the wheel)" Margin="0,6,0,0"/>
        <TextBlock TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{DynamicResource TextSecondary}"
                   Text="Tip: right-click a destination → Pin as favourite to put it on the wheel and the small bar first."/>
        <Button Content="Done — start organizing" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,20,0,0" Click="Done_Click"/>
    </StackPanel>
</Window>
