<Window x:Class="FileOrganizer.App.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Rename" Width="720" Height="540" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- §7 Batch Rename controls -->
        <StackPanel Grid.Row="0">
            <WrapPanel>
                <StackPanel Margin="0,0,12,6">
                    <TextBlock Text="Replace text"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="ReplaceFromBox" Width="110"/>
                        <TextBlock Text=" → " VerticalAlignment="Center"/>
                        <TextBox x:Name="ReplaceToBox" Width="110"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,12,6">
                    <TextBlock Text="Remove text"/>
                    <TextBox x:Name="RemoveTextBox" Width="140"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,6">
                    <TextBlock Text="Case"/>
                    <ComboBox x:Name="CaseCombo" Width="150" SelectedIndex="0">
                        <ComboBoxItem Tag="None">Keep case</ComboBoxItem>
                        <ComboBoxItem Tag="TitleCase">Title Case</ComboBoxItem>
                        <ComboBoxItem Tag="CapitalizeFirstWord">Capitalize First Word</ComboBoxItem>
                        <ComboBoxItem Tag="Upper">UPPERCASE</ComboBoxItem>
                        <ComboBoxItem Tag="Lower">lowercase</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,12,6">
                    <TextBlock Text="Prefix / Suffix"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="PrefixBox" Width="90"/>
                        <TextBox x:Name="SuffixBox" Width="90" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </WrapPanel>
            <WrapPanel Margin="0,4,0,0">
                <CheckBox x:Name="AddDateCheck" Content="Add date" VerticalAlignment="Center"/>
                <ComboBox x:Name="DateFormatCombo" Width="130" SelectedIndex="0" Margin="6,0,0,0">
                    <ComboBoxItem>yyyy-MM-dd</ComboBoxItem>
                    <ComboBoxItem>dd-MM-yyyy</ComboBoxItem>
                    <ComboBoxItem>yyyy_MM_dd</ComboBoxItem>
                    <ComboBoxItem>dd_MMM_yyyy</ComboBoxItem>
                </ComboBox>
                <ComboBox x:Name="DatePositionCombo" Width="110" SelectedIndex="0" Margin="6,0,0,0">
                    <ComboBoxItem Tag="End">at end</ComboBoxItem>
                    <ComboBoxItem Tag="Beginning">at beginning</ComboBoxItem>
                </ComboBox>
                <CheckBox x:Name="AddNumberingCheck" Content="Numbering" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <TextBlock Text=" start" VerticalAlignment="Center" Margin="6,0,2,0"/>
                <TextBox x:Name="NumberStartBox" Width="44" Text="1"/>
                <TextBlock Text=" digits" VerticalAlignment="Center" Margin="6,0,2,0"/>
                <TextBox x:Name="NumberPaddingBox" Width="34" Text="3"/>
                <Button Content="Preview" Click="Preview_Click" Margin="14,0,0,0"/>
            </WrapPanel>
            <WrapPanel Margin="0,4,0,0">
                <TextBlock Text="Rename Presets:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="PresetCombo" Width="190" Margin="0,0,6,0">
                    <ComboBox.ToolTip>Presets: Capitalize Words, Make Web-safe, Number Files, Time-Stamp Names, Underscores to Spaces, Unique Number</ComboBox.ToolTip>
                </ComboBox>
                <Button Content="Apply Preset" Click="ApplyPreset_Click"/>
                <Button Content="Save Current as Preset…" Click="SavePreset_Click"/>
                <Button Content="✎ Simple Rename" Click="SimpleRename_Click" ToolTip="Rename one item by just typing its new name"/>
            </WrapPanel>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Current name" Binding="{Binding OldName}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="→ New name" Binding="{Binding NewName}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" IsCancel="True" Width="90"/>
            <Button Content="Rename Files" FontWeight="Bold" Width="130" Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>
