<Window x:Class="FileOrganizer.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Organization Preview" Width="760" Height="460" MinWidth="520" MinHeight="300"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Review where each file will go. Uncheck anything you want to leave in place — nothing moves until you click Organize."/>
        <!-- §10 Preview Before Organizing -->
        <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="✓" Binding="{Binding Included}" Width="34"/>
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="→ Destination" Binding="{Binding DestinationFolder}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="Why" Binding="{Binding Reason}" IsReadOnly="True" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" Width="90"/>
                <Button Content="Organize" IsDefault="True" FontWeight="Bold" Width="110" Click="Organize_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
