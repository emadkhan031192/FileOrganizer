<Window x:Class="FileOrganizer.App.EdgeBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Organizer — Edge Bar" Width="230"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" AllowDrop="True">
    <Grid>
        <!-- Glass neomorphism panel: slides in from the left edge. -->
        <Border x:Name="PanelBorder" Width="224" HorizontalAlignment="Left" CornerRadius="0,18,18,0"
                BorderBrush="#FFFFFF" BorderThickness="1">
            <Border.Background>
                <SolidColorBrush Color="#EAF0F6" Opacity="0.96"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.28" Color="#8A94A6"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <TextBlock Text="FILE ORGANIZER" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Text="Push files to the left edge, then drop on a destination." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,8"/>
                    <StackPanel x:Name="DestinationsPanel"/>
                    <Button Content="⚡ Organize Current Folder" Click="Organize_Click" Margin="0,8,0,0"/>
                    <Button Content="✏ Rename Selection" Click="Rename_Click"/>
                    <Button Content="◉ Open Wheel" Click="Wheel_Click"/>
                    <Button Content="⚙ Settings" Click="Settings_Click"/>
                    <Button Content="✕ Hide Edge Bar" Click="Hide_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <!-- The peek strip: the only part visible when hidden — a thin glass line on the edge. -->
        <Border Width="6" HorizontalAlignment="Right" Background="#C7D2E0" CornerRadius="3" Opacity="0.8"/>
    </Grid>
</Window>
