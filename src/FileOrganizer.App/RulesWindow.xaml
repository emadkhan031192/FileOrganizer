<Window x:Class="FileOrganizer.App.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom Organization Rules" Width="680" Height="480" MinWidth="540" MinHeight="360"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap"
                   Text="Rules run before the extension map (lowest priority number first). Example: IF filename contains &quot;CV&quot; THEN Jobs\CV."/>
        <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,8,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Rule" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="When" Binding="{Binding Summary}" Width="2*"/>
                <DataGridTextColumn Header="→ Folder" Binding="{Binding TargetRelativeFolder}" Width="*"/>
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="64"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Add rule (§4) -->
        <GroupBox Grid.Row="2" Header="ADD RULE" Margin="0,8,0,0">
            <WrapPanel Margin="4">
                <StackPanel Margin="0,0,10,4"><TextBlock Text="Name"/><TextBox x:Name="RuleNameBox" Width="130"/></StackPanel>
                <StackPanel Margin="0,0,10,4"><TextBlock Text="Field"/>
                    <ComboBox x:Name="FieldCombo" Width="110" SelectedIndex="1">
                        <ComboBoxItem Tag="Extension">Extension</ComboBoxItem>
                        <ComboBoxItem Tag="FileName">File name</ComboBoxItem>
                        <ComboBoxItem Tag="SizeBytes">Size (bytes)</ComboBoxItem>
                    </ComboBox></StackPanel>
                <StackPanel Margin="0,0,10,4"><TextBlock Text="Operator"/>
                    <ComboBox x:Name="OperatorCombo" Width="110" SelectedIndex="1">
                        <ComboBoxItem Tag="Equals">equals</ComboBoxItem>
                        <ComboBoxItem Tag="Contains">contains</ComboBoxItem>
                        <ComboBoxItem Tag="StartsWith">starts with</ComboBoxItem>
                        <ComboBoxItem Tag="EndsWith">ends with</ComboBoxItem>
                        <ComboBoxItem Tag="GreaterThan">greater than</ComboBoxItem>
                        <ComboBoxItem Tag="LessThan">less than</ComboBoxItem>
                    </ComboBox></StackPanel>
                <StackPanel Margin="0,0,10,4"><TextBlock Text="Value"/><TextBox x:Name="ValueBox" Width="130"/></StackPanel>
                <StackPanel Margin="0,0,10,4"><TextBlock Text="→ Target folder (relative)"/><TextBox x:Name="TargetBox" Width="150"/></StackPanel>
                <Button Content="Add Rule" Click="AddRule_Click" VerticalAlignment="Bottom"/>
            </WrapPanel>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Delete Selected Rule" Click="DeleteRule_Click"/>
            <Button Content="Save &amp; Close" FontWeight="Bold" Width="120" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
