<Window x:Class="FileOrganizer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Organizer Settings" Width="560" Height="640" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="DESTINATIONS (add / remove folders here — no need to open the main window)" FontWeight="Bold"/>
                <ListBox x:Name="DestinationsList" Height="120" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Add Folder…" Click="AddDestination_Click"/>
                    <Button Content="Remove Selected" Click="RemoveDestination_Click"/>
                    <Button Content="Rename…" Click="RenameDestination_Click"/>
                    <Button Content="Open" Click="OpenDestination_Click"/>
                </StackPanel>

                <TextBlock Text="QUICK BAR CUSTOMIZATION" FontWeight="Bold" Margin="0,16,0,0"/>
                <CheckBox x:Name="ShowOrganizeOnBarCheck" Content="Show ⚡ Organize button on the bar" Margin="0,6,0,0"/>
                <CheckBox x:Name="ShowRenameOnBarCheck" Content="Show ✏ Rename button on the bar" Margin="0,4,0,0"/>
                <CheckBox x:Name="BarShowLabelsCheck" Content="Show destination names next to icons (off = icons only)" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Dock bar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="DockCombo" Width="230" SelectedIndex="0">
                        <ComboBoxItem Tag="Free">Free floating</ComboBoxItem>
                        <ComboBoxItem Tag="ExplorerTop">Inside Explorer — ribbon area (top)</ComboBoxItem>
                        <ComboBoxItem Tag="ExplorerBottom">Inside Explorer — bottom</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="EnableHotkeysCheck" Content="Enable Alt+1 … Alt+9 shortcuts (move Explorer selection to destination 1–9)" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Button size:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="BarSizeCombo" Width="90" SelectedIndex="1">
                        <ComboBoxItem Tag="S">Small</ComboBoxItem>
                        <ComboBoxItem Tag="M">Medium</ComboBoxItem>
                        <ComboBoxItem Tag="L">Large</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text=" Theme:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox x:Name="ThemeCombo" Width="90" SelectedIndex="0">
                        <ComboBoxItem Tag="Light">Light</ComboBoxItem>
                        <ComboBoxItem Tag="Dark">Dark</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text=" Accent:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <TextBox x:Name="AccentBox" Width="80" ToolTip="#RRGGBB, e.g. #2563EB"/>
                </StackPanel>

                <TextBlock Text="BEHAVIOUR" FontWeight="Bold" Margin="0,16,0,0"/>
                <CheckBox x:Name="ConfirmBeforeOrganizeCheck" Content="Show preview before organizing (recommended)" Margin="0,6,0,0"/>
                <CheckBox x:Name="NotifyAfterQuickMoveCheck" Content="Confirm after Quick Bar / right-click moves" Margin="0,4,0,0"/>
                <CheckBox x:Name="ShowQuickBarCheck" Content="Show the floating Quick Bar at startup" Margin="0,4,0,0"/>
                <CheckBox x:Name="IncludeSubfoldersCheck" Content="Include subfolders when organizing" Margin="0,4,0,0"/>
                <CheckBox x:Name="RunAtStartupCheck" Content="Start File Organizer with Windows" Margin="0,4,0,0"/>

                <TextBlock Text="EXPLORER INTEGRATION" FontWeight="Bold" Margin="0,16,0,0"/>
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Adds 'Move to Organizer' to the right-click menu for files AND folders (under 'Show more options' on Windows 11), Send To shortcuts, and 'Add as Organizer Destination' on folders. Re-install after changing destinations."/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Install / Refresh Context Menu" Click="InstallMenu_Click"/>
                    <Button Content="Remove Context Menu" Click="UninstallMenu_Click"/>
                </StackPanel>

                <TextBlock Text="CONFIGURATION (stored locally — the app works fully offline)" FontWeight="Bold" Margin="0,16,0,0"/>
                <TextBlock x:Name="ConfigPathText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Export Settings…" Click="Export_Click"/>
                    <Button Content="Import Settings…" Click="Import_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" IsCancel="True" Width="90"/>
            <Button Content="Save" IsDefault="True" FontWeight="Bold" Width="100" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
