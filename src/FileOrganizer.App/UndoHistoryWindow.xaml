<Window x:Class="FileOrganizer.App.UndoHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Undo History" Width="640" Height="440" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="BatchesList" Grid.Row="0"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="↶ Undo Selected Batch" FontWeight="Bold" Click="Undo_Click"/>
            <Button Content="Close" IsCancel="True" Width="90"/>
        </StackPanel>
    </Grid>
</Window>
