<Window x:Class="FileOrganizer.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Organizer" Width="360" Height="86" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">
    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.25" Color="#1F2937"/>
        </Border.Effect>
        <DockPanel LastChildFill="True">
            <Button x:Name="UndoBtn" DockPanel.Dock="Right" Content="↶ Undo" Margin="8,0,0,0" Click="Undo_Click"/>
            <Button DockPanel.Dock="Right" Content="✕" Click="Close_Click"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Border>
</Window>
