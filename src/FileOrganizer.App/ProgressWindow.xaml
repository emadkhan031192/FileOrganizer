<Window x:Class="FileOrganizer.App.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Organizer" Width="420" Height="170" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" Text="Moving…"/>
        <ProgressBar x:Name="Bar" Height="14" Margin="0,10,0,0" Minimum="0" Maximum="100"/>
        <TextBlock x:Name="DetailText" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}" Text="Starting…"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="90" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
