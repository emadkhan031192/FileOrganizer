<Window x:Class="FileOrganizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Organizer — Explorer Companion" Width="900" Height="600" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock x:Name="WatchDot" Text="● Watching Downloads" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" Foreground="{DynamicResource TextSecondary}"/>
                <Button x:Name="WheelBtn" Content="◉ Wheel" FontWeight="Bold" Click="WheelBtn_Click"/>
                <Button x:Name="QuickBarBtn" Content="▣ Quick Bar" Click="QuickBarBtn_Click"/>
                <Button x:Name="UndoBtn" Content="↶ Undo Last" Click="UndoBtn_Click"/>
                <Button x:Name="HistoryBtn" Content="🕘 History" Click="HistoryBtn_Click"/>
                <Button x:Name="SettingsBtn" Content="⚙ Settings" Click="SettingsBtn_Click"/>
            </StackPanel>
            <TextBlock Text="FILE ORGANIZER" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- v2: one job per tab instead of every control on one crowded screen. -->
        <TabControl Grid.Row="1" Margin="0,8,0,0">
            <TabItem Header="① Move">
                <StackPanel Margin="4">
                    <TextBlock Text="Step 1 — Select files/folders in Explorer, or drop them below." TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <Border x:Name="DropZone" AllowDrop="True" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                            CornerRadius="10" Padding="16" Margin="0,6,0,0" Background="{DynamicResource AccentSoft}"
                            Drop="DropZone_Drop" DragOver="DropZone_DragOver">
                        <TextBlock Text="📂  Drop files or folders here — the destination wheel opens. Or select in Explorer and click a destination below." TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Step 2 — Click a destination (★ = favourite, highlighted = last used). Right-click a destination for Open / Rename / Favourite / Remove." TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold"/>
                    <WrapPanel x:Name="DestinationsPanel" Margin="0,4,0,0"/>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text=" Mode:" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <ComboBox x:Name="TransferModeCombo" Width="70" SelectedIndex="0">
                            <ComboBoxItem Tag="Move">Move</ComboBoxItem>
                            <ComboBoxItem Tag="Copy">Copy</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text=" If exists:" VerticalAlignment="Center" Margin="8,0,2,0"/>
                        <ComboBox x:Name="ConflictCombo" Width="110" SelectedIndex="0">
                            <ComboBoxItem Tag="AutoRename">Auto-rename</ComboBoxItem>
                            <ComboBoxItem Tag="Skip">Skip</ComboBoxItem>
                            <ComboBoxItem Tag="Replace">Replace</ComboBoxItem>
                        </ComboBox>
                    </WrapPanel>
                    <TextBlock Text="Step 3 — The move happens on click, with progress + Cancel for big moves, then a toast with Undo." TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="② Organize">
                <StackPanel Margin="4">
                    <TextBlock Text="Step 1 — Pick the folder to sort." FontWeight="SemiBold"/>
                    <DockPanel LastChildFill="True" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseBtn_Click" Margin="6,0,0,0"/>
                        <ComboBox x:Name="RecentCombo" DockPanel.Dock="Right" Width="150" Margin="6,0,0,0" SelectionChanged="RecentCombo_SelectionChanged">
                            <ComboBox.ToolTip>Recent folders</ComboBox.ToolTip>
                        </ComboBox>
                        <TextBox x:Name="FolderBox" LostFocus="FolderBox_LostFocus"/>
                    </DockPanel>
                    <TextBlock Text="Step 2 — Organize it." FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="OrganizeBtn" Content="⚡ ORGANIZE" FontWeight="Bold" Click="OrganizeBtn_Click"/>
                        <Button x:Name="OrganizeDateBtn" Content="📅 ORGANIZE BY DATE" Click="OrganizeDateBtn_Click"/>
                        <CheckBox x:Name="DryRunCheck" Content="Dry run — preview only, move nothing" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </WrapPanel>
                    <CheckBox x:Name="WatchCheck" Content="Auto-sort new files in Downloads (watch folder — organized automatically, Undo still works)" Margin="0,8,0,0" Checked="WatchCheck_Changed" Unchecked="WatchCheck_Changed"/>
                    <TextBlock Text="Sorted Documents profile — where your document types go:" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <WrapPanel Margin="0,4,0,0">
                        <Border CornerRadius="8" Background="{DynamicResource AccentSoft}" Padding="8,4" Margin="2"><TextBlock Text="PDF → Sorted Pdfs"/></Border>
                        <Border CornerRadius="8" Background="{DynamicResource AccentSoft}" Padding="8,4" Margin="2"><TextBlock Text="Word → Sorted Word Files"/></Border>
                        <Border CornerRadius="8" Background="{DynamicResource AccentSoft}" Padding="8,4" Margin="2"><TextBlock Text="Excel → Sorted Excel Files"/></Border>
                        <Border CornerRadius="8" Background="{DynamicResource AccentSoft}" Padding="8,4" Margin="2"><TextBlock Text="PowerPoint → Sorted Powerpoint files"/></Border>
                        <Border CornerRadius="8" Background="{DynamicResource AccentSoft}" Padding="8,4" Margin="2"><TextBlock Text="Text → Sorted Text"/></Border>
                        <Border CornerRadius="8" Background="{DynamicResource AccentSoft}" Padding="8,4" Margin="2"><TextBlock Text="PSD → PSDs"/></Border>
                        <Border CornerRadius="8" Background="{DynamicResource AccentSoft}" Padding="8,4" Margin="2"><TextBlock Text="Illustrator → Illustrator Files"/></Border>
                        <Border CornerRadius="8" Background="{DynamicResource AccentSoft}" Padding="8,4" Margin="2"><TextBlock Text="HTML → Html Files"/></Border>
                        <Border CornerRadius="8" Background="{DynamicResource AccentSoft}" Padding="8,4" Margin="2"><TextBlock Text="Affinity → Affinity designer"/></Border>
                    </WrapPanel>
                    <TextBlock Text="Preview shows file count + total size (e.g. 12 files · 84 MB) and conflicts in red before anything moves." TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="③ Tools">
                <StackPanel Margin="4">
                    <WrapPanel>
                        <Button x:Name="RenameBtn" Content="✏️ RENAME…" Click="RenameBtn_Click"/>
                        <Button x:Name="DuplicatesBtn" Content="🔄 DUPLICATES" Click="DuplicatesBtn_Click"/>
                        <Button x:Name="RulesBtn" Content="⚙ RULES" Click="RulesBtn_Click"/>
                    </WrapPanel>
                    <DockPanel LastChildFill="True" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="🔍 SEARCH" Click="SearchBtn_Click" Margin="6,0,0,0"/>
                        <TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown">
                            <TextBox.ToolTip>Search by file name (in the selected folder)…</TextBox.ToolTip>
                        </TextBox>
                    </DockPanel>
                    <GroupBox Header="SEARCH RESULTS (double-click opens the folder)" Margin="0,8,0,0">
                        <ListBox x:Name="SearchResultsList" Height="220" MouseDoubleClick="SearchResultsList_MouseDoubleClick"/>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="🕘 History">
                <StackPanel Margin="4">
                    <TextBlock Text="Recent moves, newest first. For any batch — not just the last one — use History." TextWrapping="Wrap"/>
                    <Button Content="🕘 Open Full Undo History…" Click="HistoryBtn_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    <GroupBox Header="RECENT ACTIVITY" Margin="0,8,0,0">
                        <ListBox x:Name="ActivityList" Height="300"/>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Text="Ready. Tip: select files in Explorer, then click a destination — or open the ◉ Wheel."/>
        </StatusBar>
    </Grid>
</Window>
